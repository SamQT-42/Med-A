{
  "name": "med-a",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Med-A prototype: turn a work difficulty into a consented, owned, reviewed work adjustment.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "server": "node server/ai-server.mjs",
    "dev:ai": "node server/ai-server.mjs & vite",
    "verify": "node verify/golden-path.mjs && node verify/secondary-path.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
